{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "baseUrl": ".",
    "paths": {
      "react": ["../web/node_modules/react"],
      "react/jsx-runtime": ["../web/node_modules/react/jsx-runtime"],
      "react-dom/client": ["../web/node_modules/react-dom/client"],
      "weui": ["../web/node_modules/weui"],
      "vite/client": ["../web/node_modules/vite/client.d.ts"]
    },
    "typeRoots": ["../web/node_modules/@types"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src"],
  "references": []
}
